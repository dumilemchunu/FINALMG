@model TruckScheduler.Models.Truck
@{
    ViewData["Title"] = "Register Truck";
    var drivers = ViewBag.Drivers as List<TruckScheduler.Models.Driver>;
}
<h2>Register Truck</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="LicensePlate" class="form-label"></label>
        <input asp-for="LicensePlate" class="form-control" />
        <span asp-validation-for="LicensePlate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Manufacturer" class="form-label"></label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Assign Driver (optional)</label>
        <select name="DriverId" class="form-select">
            <option value="">-- none --</option>
            @foreach (var d in drivers)
            {
                <option value="@d.Id">@d.FullName</option>
            }
        </select>
    </div>

    <button class="btn btn-primary">Create</button>
    <a class="btn btn-secondary" href="/Trucks">Cancel</a>
</form>
