@model IEnumerable<TruckScheduler.Models.Truck>
@{
    ViewData["Title"] = "Trucks";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Trucks</h2>
    <a class="btn btn-success" href="/Trucks/Create">Register Truck</a>
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th>License</th>
            <th>Model</th>
            <th>Manufacturer</th>
            <th>Driver</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.LicensePlate</td>
                <td>@t.Model</td>
                <td>@t.Manufacturer</td>
                <td>@(t.Driver != null ? t.Driver.FullName : "-")</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="/Trucks/Edit/@t.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" href="/Trucks/Delete/@t.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
